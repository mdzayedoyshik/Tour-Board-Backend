# Copy to .env for local runs (never commit .env). On Render, set these in
# the service's Environment tab.

PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Firebase Admin: the service-account JSON (Firebase Console > Project
# settings > Service accounts > Generate new private key), either raw JSON
# or base64-encoded.
FIREBASE_SERVICE_ACCOUNT=

# Google Maps Platform server key restricted to Places API (New) and
# Geocoding API. Never put this key in the mobile app.
GOOGLE_MAPS_SERVER_KEY=

# Shared secret the scheduled GitHub Action sends to /internal/jobs/cleanup.
# Generate with: openssl rand -hex 32
CRON_SECRET=
