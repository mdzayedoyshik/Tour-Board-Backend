{
  "name": "tour-board-backend",
  "version": "1.0.0",
  "description": "Tour Board API: push notifications, cleanup jobs and place search",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-tour-board 'vitest run --config vitest.emulator.config.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xX0ZAK0Xx/Tour-Board-Backend.git"
  },
  "bugs": {
    "url": "https://github.com/xX0ZAK0Xx/Tour-Board-Backend/issues"
  },
  "homepage": "https://github.com/xX0ZAK0Xx/Tour-Board-Backend#readme",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
